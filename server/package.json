{
  "name": "ics-server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "postinstall": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "db": "prisma db push",
    "migrate": "prisma migrate deploy",
    "build": "prisma generate",
    "db:reset": "prisma migrate reset --force",
    "cleanup-users": "tsx prisma/cleanup-users.ts",
    "cleanup-test-roles": "tsx prisma/cleanup-test-roles.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^8.5.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}